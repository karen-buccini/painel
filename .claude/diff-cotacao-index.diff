+// Data no formato do Banco Central (MM-DD-AAAA), no fuso de São Paulo.
+function dataBC(d){
+  const [dia, mes, ano] = d.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'}).split('/');
+  return `${mes}-${dia}-${ano}`;
+}
+async function cotacaoBC(moeda){
+  const hoje = new Date();
+  const inicio = new Date(hoje.getTime() - 15*864e5); // cobre feriados emendados
+  const url = 'https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/'
+    + 'CotacaoMoedaPeriodo(moeda=@moeda,dataInicial=@dataInicial,dataFinalCotacao=@dataFinalCotacao)'
+    + `?@moeda='${moeda}'&@dataInicial='${dataBC(inicio)}'&@dataFinalCotacao='${dataBC(hoje)}'&$format=json`;
+  const res = await fetch(url);
+  if(!res.ok) throw new Error('HTTP ' + res.status);
+  const lista = (await res.json()).value || [];
+  if(!lista.length) throw new Error('sem boletins');
+  const ultimo = lista[lista.length-1];
+  const dia = ultimo.dataHoraCotacao.slice(0,10);
+  const fechAnterior = lista.filter(b => String(b.tipoBoletim).startsWith('Fechamento') && b.dataHoraCotacao.slice(0,10) < dia).pop();
+  const value = ultimo.cotacaoVenda;
+  const pct = fechAnterior ? (value/fechAnterior.cotacaoVenda - 1) * 100 : 0;
+  return { value, pct };
+}
+async function cotacaoBinance(par){
+  const res = await fetch('https://api.binance.com/api/v3/ticker/24hr?symbol=' + par);
+  if(!res.ok) throw new Error('HTTP ' + res.status);
+  const d = await res.json();
+  const value = parseFloat(d.lastPrice), pct = parseFloat(d.priceChangePercent);
+  if(!(value > 0)) throw new Error('preço inválido');
+  return { value, pct };
+}
