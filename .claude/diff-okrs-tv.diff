+// ---------- OKRs DO CICLO (okrResumo + okr) ----------
+// Mesmas regras da prévia aprovada (.claude/previa/index.html):
+// - % do KR = atual ÷ meta, sem teto (a barra é que para no fim);
+// - KR "menor" (inadimplência): % = meta ÷ atual; até a meta verde, até
+//   atencaoAte amarelo, acima vermelho;
+// - KR "congelado" (NPS) fica fora das médias;
+// - média do objetivo = média simples dos KRs (sem número conta 0%);
+// - geral = média de todos os KRs ativos;
+// - nos slides de KR a cor vem das faixas 50% / 30%; no resumo, os pontinhos
+//   seguem o ritmo do trimestre.
+// Os números vêm do data.json (slides "okr"), copiados do artefato de OKRs.
+const okrFaixa = p => p > .5 ? 'okr-ok' : p >= .3 ? 'okr-atencao' : 'okr-atras';
+const OKR_ROTULO_FAIXA = {'okr-ok':'no ritmo', 'okr-atencao':'atenção', 'okr-atras':'abaixo do ritmo'};
+const okrAtivos = l => l.filter(k=>!k.congelado);
+const okrPct = k => k.atual == null ? null : k.menor ? (k.atual > 0 ? k.meta/k.atual : 2) : k.atual/k.meta;
+const okrMedia = l => l.length ? l.reduce((a,b)=>a+b,0)/l.length : null;
+
+// Datas em São Paulo, em dias UTC (sem fuso): hoje, início e fim do ciclo.
+function okrHoje(){
+  const { dia, ano } = agoraEmSaoPaulo();
+  const [d, m] = dia.split('/').map(Number);
+  return { t: Date.UTC(ano, m-1, d), ano };
+}
+function okrPeriodo(){
+  const r = allSlides.find(x => x.type==='okrResumo') || {};
+  const { t, ano } = okrHoje();
+  const ini = r.inicio ? Date.parse(r.inicio+'T00:00:00Z') : Date.UTC(ano, 9, 1);
+  const fim = r.fim ? Date.parse(r.fim+'T00:00:00Z') : Date.UTC(ano, 11, 31);
+  const decorrido = (t-ini)/(fim-ini+864e5);
+  const q = 'Q' + (Math.floor(new Date(ini).getUTCMonth()/3) + 1);
+  return { decorrido, q, rotulo: `${q} · ${Math.round(decorrido*100)}% do trimestre` };
+}
+function okrSelo(k){
+  if(!k.em) return '';
+  const { t, ano } = okrHoje();
+  const segunda = t - ((new Date(t).getUTCDay()+6)%7) * 864e5;
+  const [d, m] = k.em.split('/').map(Number);
+  const velho = Date.UTC(ano, m-1, d) < segunda;
+  return `<span class="okr-atz${velho?' okr-velho':''}"><i></i>${k.em}</span>`;
+}
+function okrLinha(k){
+  const fmt = v => (k.pre||'') + v.toLocaleString('pt-BR') + (k.un||'');
+  const nota = k.nota ? `<div class="okr-nota">${k.nota}</div>` : '';
+  if(k.atual == null){
+    return `<div class="okr-kr">${okrSelo(k)}
+      <div><div class="okr-val okr-vazio">—<span class="okr-meta"> / ${fmt(k.meta)}</span></div>${nota}</div>
+      <div><div class="okr-txt"><span><b>${k.b}</b> ${k.t}</span></div><div class="okr-track"></div></div>
+      <div class="okr-status"><span class="okr-pct" style="color:rgba(255,255,255,.28)">—</span>${k.status || 'aguardando'}</div>
+    </div>`;
+  }
+  if(k.menor){
+    const dentro = k.atual <= k.meta;
+    const atencao = !dentro && k.atencaoAte != null && k.atual <= k.atencaoAte;
+    const ating = k.atual > 0 ? k.meta/k.atual : 2;
+    return `<div class="okr-kr ${dentro?'okr-ok':atencao?'okr-atencao':'okr-atras'}">${okrSelo(k)}
+      <div><div class="okr-val">${fmt(k.atual)}<span class="okr-meta"> / ${k.metaTxt || fmt(k.meta)}</span></div>${nota}</div>
+      <div><div class="okr-txt"><span><b>${k.b}</b> ${k.t}</span></div>
+        <div class="okr-track"><div class="okr-fill" style="width:${Math.min(ating,1)*100}%"></div></div></div>
+      <div class="okr-status"><span class="okr-pct">${Math.round(ating*100)}%</span>${dentro?'dentro da meta':'acima da meta'}</div>
+    </div>`;
+  }
+  const p = k.atual/k.meta, larg = Math.min(p,1)*100;
+  const cls = okrFaixa(p);
+  let st;
+  if(k.acumulado){
+    const falta = k.meta - k.atual;
+    st = falta>0 ? 'faltam '+(+falta.toFixed(1)).toLocaleString('pt-BR')+(k.faltaUn||'') : (k.taxa ? 'no ritmo' : 'batido');
+  } else {
+    st = p>=1 ? 'batido' : OKR_ROTULO_FAIXA[cls];
+  }
+  return `<div class="okr-kr ${cls}">${okrSelo(k)}
+    <div><div class="okr-val">${fmt(k.atual)}<span class="okr-meta"> / ${k.metaTxt || fmt(k.meta)}</span></div>${nota}</div>
+    <div><div class="okr-txt"><span><b>${k.b}</b> ${k.t}</span></div>
+      <div class="okr-track"><div class="okr-fill" style="width:${larg}%"></div></div></div>
+    <div class="okr-status"><span class="okr-pct">${Math.round(p*100)}%</span>${st}</div>
+  </div>`;
+}
+// Pontinhos do resumo: ritmo do trimestre; total/taxa em azul.
+function okrStatusResumo(k, decorrido){
+  const p = okrPct(k);
+  if(k.congelado) return 'okr-cong';
+  if(p == null) return 'okr-vazio';
+  if(k.acumulado) return p>=1 ? 'okr-ok' : 'okr-acum';
+  if(k.menor) return p>=1 ? 'okr-ok' : (k.atencaoAte != null && k.atual <= k.atencaoAte) ? 'okr-atencao' : 'okr-atras';
+  const r = p/decorrido;
+  return p>=1 || r>=1 ? 'okr-ok' : r>=.7 ? 'okr-atencao' : 'okr-atras';
+}
+function okrAnel(p){
+  const R = 46, C = 2*Math.PI*R;
+  const fill = p == null ? '' :
+    `<circle cx="56" cy="56" r="${R}" fill="none" stroke="var(--gold)" stroke-width="10" stroke-linecap="round"
+       stroke-dasharray="${C*Math.min(p,1)} ${C}" transform="rotate(-90 56 56)"/>`;
+  return `<svg width="112" height="112" viewBox="0 0 112 112">
+    <circle cx="56" cy="56" r="${R}" fill="none" stroke="rgba(255,255,255,.09)" stroke-width="10"/>${fill}
+    <text x="56" y="64" text-anchor="middle" fill="${p==null?'rgba(255,255,255,.3)':'#fff'}" font-family="Rubik" font-size="26" font-weight="500">${p==null?'—':Math.round(p*100)+'%'}</text>
+  </svg>`;
+}
+function renderOkrResumo(s){
+  const objetivos = allSlides.filter(x => x.type==='okr');
